#version 450
layout(local_size_x=64, local_size_y=1, local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer X { float x[]; };
layout(set=0,binding=1,std430) writeonly buffer Y { float y[]; };
layout(push_constant) uniform P { uint n; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    float v = x[i];
    // Exact GELU formulation (erf), matching the CPU reference.
    y[i] = 0.5 * v * (1.0 + erf(v * 0.70710678118654752440));
}
