#version 450
layout(local_size_x=64, local_size_y=1, local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer X { float x[]; };
layout(set=0,binding=1,std430) writeonly buffer Y { float y[]; };
layout(push_constant) uniform P { uint rows; uint axisN; uint inner; } p;
shared float sm[64];
void main(){ uint row=gl_WorkGroupID.x; uint lane=gl_LocalInvocationID.x; if(row>=p.rows)return; uint outer=row/p.inner, inr=row%p.inner; float mx=-3.402823e38; for(uint a=lane;a<p.axisN;a+=64)mx=max(mx,x[(outer*p.axisN+a)*p.inner+inr]); sm[lane]=mx; barrier(); for(uint s=32;s>0;s>>=1){if(lane<s)sm[lane]=max(sm[lane],sm[lane+s]);barrier();} mx=sm[0]; float sum=0; for(uint a=lane;a<p.axisN;a+=64)sum+=exp(x[(outer*p.axisN+a)*p.inner+inr]-mx); sm[lane]=sum; barrier(); for(uint s=32;s>0;s>>=1){if(lane<s)sm[lane]+=sm[lane+s];barrier();} sum=sm[0]; for(uint a=lane;a<p.axisN;a+=64)y[(outer*p.axisN+a)*p.inner+inr]=exp(x[(outer*p.axisN+a)*p.inner+inr]-mx)/sum; }
