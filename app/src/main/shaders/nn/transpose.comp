#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer X{float x[];};
layout(set=0,binding=1,std430) writeonly buffer Y{float y[];};
layout(push_constant, std430) uniform P{uint rank;uint dims[4];uint perm[4];uint outDims[4];}p;
void main(){
 uint oi=gl_GlobalInvocationID.x; uint total=1;
 for(uint i=0;i<p.rank;i++) total*=p.outDims[i];
 if(oi>=total)return;
 uint t=oi, src=0;
 for(uint j=0;j<4;j++){
   if(j<p.rank){
     uint q=p.rank-1-j;
     uint coord=t%p.outDims[q]; t/=p.outDims[q];
     uint sa=p.perm[q], stride=1;
     for(uint k=sa+1;k<p.rank;k++) stride*=p.dims[k];
     src+=coord*stride;
   }
 }
 y[oi]=x[src];
}
